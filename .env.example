# Contact form — sends via a Brevo-backed serverless function at /api/contact.
# 1. Create a free Brevo account: https://www.brevo.com
# 2. Generate a Restricted API key with "Transactional email: All" and
#    nothing else enabled (Settings → SMTP & API → API Keys).
# 3. Verify a sender address (Settings → Senders & IP → Senders).
# 4. Copy this file to .env.local and fill in the values below.
# 5. On Vercel, add the same BREVO_* variables under
#    Project Settings → Environment Variables for production.

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_RECEIVER_EMAIL=

# Leave this as /api/contact — it's the local function path, not an
# external URL. If left blank, the form falls back to opening the
# visitor's email app instead of sending via Brevo.
VITE_FORM_ENDPOINT=/api/contact